{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "focus.",
  "version": "0.1.0",
  "identifier": "com.focus-local.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && node ../../scripts/stage-desktop-policy-helper.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "capabilities": [{ "identifier": "main-page-zoom", "windows": ["main"], "permissions": ["core:webview:allow-set-webview-zoom"] }]
    },
    "windows": [
      {
        "title": "focus.",
        "width": 960,
        "height": 640,
        "zoomHotkeysEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 17 }
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "linux": {
      "deb": {
        "recommends": ["pkexec"],
        "files": {
          "/usr/libexec/focus-browser-policy": "target/focus-installer/native/focus-browser-policy"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
