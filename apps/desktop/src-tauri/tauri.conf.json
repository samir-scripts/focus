{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "focus.",
  "version": "0.1.0",
  "identifier": "com.focus-local.desktop",
  "build": {
    "beforeDevCommand": "node ../../scripts/stage-glance.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node ../../scripts/stage-glance.mjs && npm run build && node ../../scripts/stage-desktop-policy-helper.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "capabilities": [{
        "identifier": "main-page-zoom",
        "windows": ["main", "sessions"],
        "permissions": [
          "core:webview:allow-set-webview-zoom",
          "core:event:allow-listen",
          "core:event:allow-unlisten"
        ]
      }]
    },
    "windows": [
      {
        "title": "focus.",
        "width": 960,
        "height": 640,
        "zoomHotkeysEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 17 }
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../../docs/design/productivity/references/3f-glance-LICENSE.txt": "Glance-LICENSE.txt"
    },
    "linux": {
      "deb": {
        "recommends": ["pkexec"],
        "files": {
          "/usr/libexec/focus-browser-policy": "target/focus-installer/native/focus-browser-policy"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
