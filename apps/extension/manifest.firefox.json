{
  "manifest_version": 3,
  "name": "focus.",
  "version": "0.2.0",
  "description": "Apply your focus. preferences in this browser profile.",
  "permissions": ["storage", "nativeMessaging", "scripting", "alarms", "declarativeNetRequestWithHostAccess", "webNavigation"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "web_accessible_resources": [{ "resources": ["entry.html"], "matches": ["http://*/*", "https://*/*"] }],
  "background": { "scripts": ["background.js"] },
  "browser_specific_settings": { "gecko": {
    "id": "focus@focus-local",
    "strict_min_version": "160.0",
    "strict_min_version_android": "160.0",
    "data_collection_permissions": { "required": ["none"] }
  } },
  "action": { "default_title": "focus.", "default_popup": "popup.html" },
  "incognito": "not_allowed"
}
